# Shohay Frontend Environment Variables
# Copy to .env for local development
VITE_API_BASE_URL=https://shohaybackend.vercel.app

# Supabase Auth (Project Settings > API: Project URL and anon/publishable key)
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
